# Copy this file to .env (in this folder) and fill in your real key.
# Never commit the real .env.
PORTKEY_API_KEY=your_portkey_api_key_here

# Safety default: opt-out submission is a real action against a live
# third-party site. Leave this unset/true for all routine testing (the
# optout agent will report what it WOULD have done without sending
# anything). Only set to false for an intentional, real opt-out run.
DRY_RUN_OPTOUT=true
